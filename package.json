{
  "name": "holberton-self-learning-hub",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": { "node": ">=26.13.0 <27" },
  "scripts": {
    "dev": "pnpm --parallel --filter @hub/server --filter @hub/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @hub/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-boundaries": "7.4.0",
    "globals": "^17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
