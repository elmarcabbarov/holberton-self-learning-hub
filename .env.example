# Copy to .env. Never commit .env.
HUB_PORT=3000
# Host folder that holds the Hub vault, database and backups.
HUB_DATA=./.data
# Optional: an existing Markdown/Obsidian vault, mounted read-only.
# LINKED_VAULT=/home/you/Notes
# local (default, loopback + bootstrap token) | remote (password + HTTPS proxy required)
HUB_MODE=local
